### ============================================================
### 3. НАЗНАЧЕНИЕ РОЛЕЙ (выполни SQL напрямую в БД или через ADMIN)
### SQL:
### UPDATE users SET id=id WHERE inn='10000000000001'; -- уже есть
### INSERT INTO m2m_users_roles(user_id, role_id) SELECT u.id, r.id FROM users u, roles r WHERE u.inn='10000000000001' AND r.role_name='ADMIN';
### INSERT INTO m2m_users_roles(user_id, role_id) SELECT u.id, r.id FROM users u, roles r WHERE u.inn='10000000000002' AND r.role_name='DOCTOR';
### INSERT INTO m2m_users_roles(user_id, role_id) SELECT u.id, r.id FROM users u, roles r WHERE u.inn='10000000000003' AND r.role_name='DOCTOR';
### INSERT INTO m2m_users_roles(user_id, role_id) SELECT u.id, r.id FROM users u, roles r WHERE u.inn='10000000000004' AND r.role_name='CLINIC_ADMIN';
### INSERT INTO m2m_users_roles(user_id, role_id) SELECT u.id, r.id FROM users u, roles r WHERE u.inn='10000000000005' AND r.role_name='COMPANY_HR';
### ============================================================


